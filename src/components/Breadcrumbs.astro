---
interface Props {
	sections: Section[];
	currentTitle: string;
}

interface Section {
	name: string;
	prefix: string;
}

const { sections, currentTitle } = Astro.props;
const currentPath = Astro.url.pathname;
const sectionBreadcrumbs = sections.filter(
	(s) => currentPath.startsWith(s.prefix) && currentPath !== s.prefix
);
---

<nav class="breadcrumbs">
	<ol>
		{
			sectionBreadcrumbs.map((b) => (
				<li>{<a href={b.prefix}>{b.name}</a>}</li>
			))
		}{(<li>{<b aria-current="page">{currentTitle}</b>}</li>)}
	</ol>
</nav>

<style>
	.breadcrumbs ol {
		list-style-type: none;
		padding: 0em;
		margin: 0.375em 0em;
	}
	.breadcrumbs li {
		display: inline-block;
	}
	.breadcrumbs li:before {
		content: '\25b8';
		margin: 0em 0.5em;
	}
	:global([dir='rtl']) .breadcrumbs li:before {
		content: '\25c2';
	}
	.breadcrumbs li:first-child:before,
	:global([dir]) .breadcrumbs li:first-child:before {
		content: '';
		margin: 0em;
	}
	@media print {
		.breadcrumbs {
			display: none;
		}
	}
</style>
